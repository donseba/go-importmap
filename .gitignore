# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
.idea/
example/assets/
example/.importmap/
.importmap
# Files the example and older tests published; the assets package and the
# logo live here too.
/assets/*
!/assets/*.go
!/assets/go-importmap-logo.png
